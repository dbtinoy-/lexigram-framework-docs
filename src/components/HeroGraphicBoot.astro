---
// src/components/HeroGraphicBoot.astro
// Application Boot Flow — providers lighting up in priority order
import '../styles/hero-graphic.css';
---

<div class="hg-wrapper">
  <div class="glow-blob blob-1"></div>
  <div class="glow-blob blob-2"></div>

  <div class="hg-card">

    <!-- Window chrome -->
    <div class="hg-header">
      <div class="mac-dots">
        <span class="dot close"></span>
        <span class="dot min"></span>
        <span class="dot max"></span>
      </div>
      <span class="hg-title">lexigram · application boot</span>
      <span class="hg-badge">● Live</span>
    </div>

    <!-- Body: two columns -->
    <div class="hg-body">

      <!-- LEFT: condensed code snippet -->
      <div class="hg-code">
        <div class="code-file-tab">main.py</div>
        <pre><code><span class="c"># one application, every provider wired</span>
<span class="kw">from</span> lexigram <span class="kw">import</span> Application
<span class="kw">from</span> lexigram.web <span class="kw">import</span> WebProvider
<span class="kw">from</span> lexigram.sql <span class="kw">import</span> DatabaseProvider
<span class="kw">from</span> lexigram.cache <span class="kw">import</span> CacheProvider
<span class="kw">from</span> lexigram.ai.llm <span class="kw">import</span> LLMProvider

app = <span class="fn">Application</span>(name=<span class="st">"my-app"</span>)
app.add_providers([
    <span class="fn">DatabaseProvider</span>(),
    <span class="fn">CacheProvider</span>(),
    <span class="fn">WebProvider</span>(),
    <span class="fn">LLMProvider</span>(),
])

<span class="kw">await</span> app.start()</code></pre>
      </div>

      <!-- RIGHT: live boot trace -->
      <div class="hg-trace">

        <!-- DatabaseProvider -->
        <div class="trace-row">
          <div class="trace-node wire-node">
            <div class="tn-icon" style="color:#38bdf8;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v6c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 11v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6"/></svg>
            </div>
            <div class="tn-text">
              <span class="tn-label" style="color:rgba(56,189,248,0.7);">Provider · priority=DATA</span>
              <span class="tn-value">DatabaseProvider</span>
            </div>
          </div>
        </div>

        <div class="trace-connector"></div>

        <!-- CacheProvider -->
        <div class="trace-row">
          <div class="trace-node wire-node">
            <div class="tn-icon" style="color:#38bdf8;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <div class="tn-text">
              <span class="tn-label" style="color:rgba(56,189,248,0.7);">Provider · priority=DATA</span>
              <span class="tn-value">CacheProvider</span>
            </div>
          </div>
        </div>

        <div class="trace-connector"></div>

        <!-- WebProvider -->
        <div class="trace-row">
          <div class="trace-node wire-node">
            <div class="tn-icon" style="color:#38bdf8;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <div class="tn-text">
              <span class="tn-label" style="color:rgba(56,189,248,0.7);">Provider · priority=WEB</span>
              <span class="tn-value">WebProvider</span>
            </div>
          </div>
        </div>

        <div class="trace-connector"></div>

        <!-- LLMProvider -->
        <div class="trace-row">
          <div class="trace-node agent-node">
            <div class="tn-icon" style="color:#a855f7;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a8 8 0 0 1 8 8c0 5-8 12-8 12S4 15 4 10a8 8 0 0 1 8-8z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="tn-text">
              <span class="tn-label" style="color:rgba(168,85,247,0.7);">Provider · priority=AI</span>
              <span class="tn-value">LLMProvider</span>
            </div>
            <div class="thinking-dots"><span></span><span></span><span></span></div>
          </div>
        </div>

        <div class="trace-connector"></div>

        <!-- Ready -->
        <div class="trace-row">
          <div class="trace-node result-node">
            <div class="tn-icon" style="color:#22c55e;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="tn-text">
              <span class="tn-label" style="color:rgba(34,197,94,0.7);">Application · ready</span>
              <span class="tn-value">0.42s · 4 providers</span>
            </div>
            <div class="status-glow"></div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  /* Variant accents only — sky / purple palette to echo the wired-up theme. */
  .blob-1 { width: 280px; height: 280px; top: -40px; left: -40px; background: rgba(56, 189, 248, 0.30); }
  .blob-2 { width: 260px; height: 260px; bottom: -40px; right: -20px; background: rgba(168, 85, 247, 0.20); }
</style>
