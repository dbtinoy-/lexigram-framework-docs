---
import { Icon } from '@astrojs/starlight/components';
---

<button
	id="theme-toggle"
	class="theme-toggle-btn"
	aria-label="Toggle theme"
	title="Toggle between dark and light mode"
>
	<div class="icon-wrapper sun">
		<Icon name="sun" size="1.25rem" />
	</div>
	<div class="icon-wrapper moon">
		<Icon name="moon" size="1.25rem" />
	</div>
</button>

<script is:inline>
	(function () {
		const toggle = document.getElementById('theme-toggle');
		if (!toggle) return;

		const getTheme = () => {
			if (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme')) {
				return localStorage.getItem('starlight-theme');
			}
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		};

		const setTheme = (theme) => {
			document.documentElement.setAttribute('data-theme', theme);
			localStorage.setItem('starlight-theme', theme);
			updateIcon(theme);
		};

		const updateIcon = (theme) => {
			const sun = toggle.querySelector('.sun');
			const moon = toggle.querySelector('.moon');
			if (theme === 'dark') {
				sun.style.display = 'none';
				moon.style.display = 'flex';
			} else {
				sun.style.display = 'flex';
				moon.style.display = 'none';
			}
		};

		// Initial state
		updateIcon(getTheme());

		toggle.addEventListener('click', () => {
			const currentTheme = getTheme();
			const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
			setTheme(newTheme);
		});

		// Listen for Starlight's own theme changes if any
		const observer = new MutationObserver((mutations) => {
			mutations.forEach((mutation) => {
				if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
					updateIcon(document.documentElement.getAttribute('data-theme'));
				}
			});
		});

		observer.observe(document.documentElement, { attributes: true });
	})();
</script>

<style>
	.theme-toggle-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		background: transparent;
		cursor: pointer;
		color: var(--sl-color-gray-2);
		transition: all 0.2s ease;
		padding: 0;
		overflow: hidden;
	}

	.theme-toggle-btn:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-5);
		border-color: var(--sl-color-gray-4);
	}

	.icon-wrapper {
		display: none;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		animation: scale-in 0.2s ease-out;
	}

	@keyframes scale-in {
		from {
			transform: scale(0.5);
			opacity: 0;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}

	:global([data-theme='light']) .theme-toggle-btn {
		border-color: var(--sl-color-gray-5);
	}

	:global([data-theme='light']) .theme-toggle-btn:hover {
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-black);
	}
</style>
