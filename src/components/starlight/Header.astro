---
import type { Props } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="header sl-flex">
	<div class="header-left sl-flex">
		<!-- Logo — matches lexigram-website Navbar style -->
		<a href="/" class="site-logo" aria-label="Lexigram Framework Docs">
			<img src="/logo.png" alt="Lexigram Logo" class="logo-img" />
			<div class="logo-text">
				<span class="logo-title">Lexigram</span>
				<span class="logo-subtitle">FRAMEWORK DOCS</span>
			</div>
		</a>

		<div class="search-wrapper">
			<Search {...Astro.props} />
		</div>
	</div>

	<div class="header-right sl-flex">
		<div class="header-icons sl-flex">
			<SocialIcons {...Astro.props} />
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.header {
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
		padding: 0 var(--sl-nav-pad-x);
	}

	.header-left {
		align-items: center;
		gap: 1.5rem;
		flex: 1;
		min-width: 0;
	}

	/* ── Logo ─────────────────────────────────────────────── */
	.site-logo {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		flex-shrink: 0;
		text-decoration: none !important;
		transition: opacity 0.2s ease;
	}

	.site-logo:hover {
		opacity: 0.85;
	}

	.logo-img {
		width: 2.25rem;   /* 36px — same as website w-9 */
		height: 2.25rem;
		object-fit: contain;
		flex-shrink: 0;
		transition: transform 0.25s ease;
	}

	.site-logo:hover .logo-img {
		transform: scale(1.08);
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.logo-title {
		font-family: var(--sl-font-heading);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		/* Dark theme (default) */
		color: #ffffff;
	}

	.logo-subtitle {
		font-family: var(--sl-font-mono);
		font-size: 0.6rem;
		font-weight: 400;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		/* Dark theme (default) */
		color: var(--color-text-weaker);
		margin-top: 0.15rem;
	}

	/* Light theme overrides */
	:root[data-theme='light'] .logo-title {
		color: #050505;
	}

	:root[data-theme='light'] .logo-subtitle {
		color: var(--color-text-weaker);
	}

	/* ── Search ───────────────────────────────────────────── */
	.search-wrapper {
		flex: 1;
		min-width: 0;
		max-width: 28rem;
	}

	/* ── Right side ───────────────────────────────────────── */
	.header-right {
		gap: 0.5rem;
		align-items: center;
		flex-shrink: 0;
	}

	.header-icons {
		gap: 0.5rem;
		align-items: center;
		padding-inline-start: 0.5rem;
		border-inline-start: 1px solid var(--color-border);
	}
</style>
